# Cuenta Gmail que envía el formulario de contacto (/api/contact).
# EMAIL_PASS debe ser una contraseña de aplicación, no la del correo.
EMAIL_USER=
EMAIL_PASS=

# Opcional. Sin token, la API pública de GitHub permite 60 peticiones/hora
# por IP; con token, 5.000. La ruta cachea la respuesta 1 hora.
GITHUB_USERNAME=LuisRocca
GITHUB_TOKEN=
